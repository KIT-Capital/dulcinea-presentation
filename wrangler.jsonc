{
  "name": "dulcinea-investor-presentation",
  "account_id": "691c05eedd282317f3311e441d77a007",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "invest.dulcineainvestments.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/private-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "vars": { "PREVIEW_ONLY": "false" },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "92620261", "simple": { "limit": 8, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
